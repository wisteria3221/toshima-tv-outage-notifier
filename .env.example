# X API認証情報（Developer Portalから取得）
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# オプション設定
DRY_RUN=false
LOG_LEVEL=INFO

# Healthchecks.io Management API キー（ローカルで healthchecks-api スキルを使う場合のみ）
# HEALTHCHECKS_API_KEY=your_healthchecks_api_key_here

# cron-job.org API キー（ローカルで cron-job-org-api スキルを使う場合のみ）
# CRONJOB_API_KEY=your_cronjob_api_key_here
